# Cloud providers (optional)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging
STATUS_INTERVAL_MS=1000
