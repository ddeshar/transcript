# Core configuration
ASR_PROVIDER=vosk
MT_PROVIDER=marian
AUDIO_SAMPLE_RATE=16000
CORS_ORIGINS=http://localhost:8000

# Offline model locations (populated via scripts/download_models.py)
VOSK_MODEL_DIR=./models/vosk/vosk-model-small-en-us-0.15
WHISPER_CPP_MODEL_PATH=./models/whisper.cpp/ggml-small.en.bin
MARIAN_MODEL_DIR=./models/marian

# CTranslate2 (optional offline MT)
CT2_MODEL_DIR=./models/ctranslate2/en-th
CT2_DEVICE=auto
CT2_COMPUTE_TYPE=int8_float16
CT2_BEAM_SIZE=1
CT2_MAX_LEN=256
CT2_SOURCE_PREFIX=

# Cloud providers (optional)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HUGGINGFACE_TOKEN=

# Logging
STATUS_INTERVAL_MS=1000
