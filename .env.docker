# Docker-specific configuration (faster-whisper ASR + Simple Thai MT)
ASR_PROVIDER=faster_whisper
MT_PROVIDER=simple_thai
AUDIO_SAMPLE_RATE=16000
CORS_ORIGINS=http://localhost:8000

# Docker paths (models are copied to /app/models)
VOSK_MODEL_DIR=/app/models/vosk/vosk-model-small-en-us-0.15
WHISPER_CPP_MODEL_PATH=/app/models/whisper.cpp/ggml-small.en.bin
MARIAN_MODEL_DIR=/app/models/marian-en-th

# Faster-Whisper configuration optimized for speed
FASTER_WHISPER_MODEL=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_CHUNK_DURATION=1.0

# CTranslate2 (optional offline MT)
CT2_MODEL_DIR=/app/models/ctranslate2/en-th
CT2_DEVICE=auto
CT2_COMPUTE_TYPE=int8_float16
CT2_BEAM_SIZE=1
CT2_MAX_LEN=256
CT2_SOURCE_PREFIX=

# Cloud providers (optional)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HUGGINGFACE_TOKEN=

# Logging
STATUS_INTERVAL_MS=1000