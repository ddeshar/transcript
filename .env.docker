# Docker-specific configuration (OpenAI for ASR and MT)
ASR_PROVIDER=whisper_api
MT_PROVIDER=openai_gpt

# Speed optimization for real-time translation
OPENAI_GPT_MAX_TOKENS=100
AUDIO_SAMPLE_RATE=16000
MIN_SILENCE_MS=500
CORS_ORIGINS=http://localhost:8000

# Docker paths (models are copied to /app/models)
VOSK_MODEL_DIR=/app/models/vosk/vosk-model-small-en-us-0.15
WHISPER_CPP_MODEL_PATH=/app/models/whisper.cpp/ggml-small.en.bin
MARIAN_MODEL_DIR=/app/models/marian-en-th

# Faster-Whisper configuration optimized for MAXIMUM speed
FASTER_WHISPER_MODEL=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_CHUNK_DURATION=0.5

# Official OpenAI Whisper (local) - Better accuracy than faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_CHUNK_DURATION=2.0

# CTranslate2 (optional offline MT)
CT2_MODEL_DIR=/app/models/ctranslate2/en-th
CT2_DEVICE=auto
CT2_COMPUTE_TYPE=int8_float16
CT2_BEAM_SIZE=1
CT2_MAX_LEN=256
CT2_SOURCE_PREFIX=

# Cloud providers (optional - needed for whisper_gpt and hybrid quality)
OPENAI_API_KEY=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
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_GPT_MODEL=gpt-3.5-turbo
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIATHQ5NODG2YFOSBHF
AWS_SECRET_ACCESS_KEY=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
AWS_S3_BUCKET=transcript-audio-bucket

HUGGINGFACE_TOKEN=

# Real-time optimization
MIN_SILENCE_MS=500
STATUS_INTERVAL_MS=1000
HYBRID_FAST_THRESHOLD_MS=300
HYBRID_QUALITY_DELAY_MS=2000

# Thai translation settings
THAI_POLITENESS_GENDER=male

# Enhanced noise filtering and quality control - ULTRA AGGRESSIVE  
MIN_TRANSLATION_WORDS=3
MIN_TRANSLATION_CHARS=10
ENABLE_NOISE_DETECTION=true

# WhisperGPT Provider specific settings
WHISPER_GPT_MODEL=whisper-1
WHISPER_GPT_TEMPERATURE=0.0