# ===== APPLICATION SETTINGS =====
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== DATABASE CONFIGURATION =====
# PostgreSQL Database (Production)
DATABASE_URL=postgresql://seminar_user:seminar_pass@db:5432/seminar_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_ECHO=false

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://redis:6379/0
SESSION_TIMEOUT=3600

# ===== AUTHENTICATION & SECURITY =====
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
CREATE_ADMIN_ON_STARTUP=true

# ===== ASR PROVIDER CONFIGURATION =====
# Options: mock, vosk, whispercpp, faster_whisper, whisper_local, gpt_realtime, gpt_4o_audio, hybrid
ASR_PROVIDER=mock

# ===== MT PROVIDER CONFIGURATION =====
# Options: mock, simple_thai, marian, ctranslate2, gtranslate, awstranslate, openai_gpt
MT_PROVIDER=simple_thai

# ===== TTS PROVIDER CONFIGURATION =====
# Text-to-Speech for Thai audio output
TTS_PROVIDER=disabled
TTS_VOICE=nova
TTS_SPEED=1.0
OPENAI_TTS_MODEL=tts-1
OPENAI_GPT_MAX_TOKENS=100
OPENAI_GPT_MODEL=gpt-3.5-turbo

# Official OpenAI Whisper (local) - Better accuracy than faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_CHUNK_DURATION=2.0

# CTranslate2 (optional offline MT)
CT2_MODEL_DIR=/app/models/ctranslate2/en-th
CT2_DEVICE=auto
CT2_COMPUTE_TYPE=int8_float16
CT2_BEAM_SIZE=1
CT2_MAX_LEN=256
CT2_SOURCE_PREFIX=

# ===== CLOUD API KEYS =====
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_WHISPER_MODEL=whisper-1

# Google Cloud Configuration
GCP_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name

# HuggingFace Configuration
HUGGINGFACE_TOKEN=your-huggingface-token

# ===== MEDIA & FILE STORAGE =====
MEDIA_ROOT=/app/media
AUDIO_UPLOAD_PATH=/app/media/audio
AUDIO_STORAGE_PATH=/app/media/audio
SUBTITLE_EXPORT_PATH=/app/media/exports
BACKUP_PATH=/app/backups
MAX_AUDIO_FILE_SIZE_MB=100
AUDIO_FORMATS=wav,mp3,m4a,webm
AUDIO_SAMPLE_RATE=16000

# ===== WEBSOCKET & PERFORMANCE =====
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_TIMEOUT=300
AUDIO_CHUNK_SIZE=8192
MIN_SILENCE_MS=500
MAX_SILENCE_DURATION=30

# ===== ANALYTICS & MONITORING =====
PARTICIPANT_STATS_INTERVAL=300
ANALYTICS_RETENTION_DAYS=90
ENABLE_REAL_TIME_ANALYTICS=true
EXPORT_FORMATS=json,csv,xlsx

# ===== LOGGING & MONITORING =====
LOG_FILE=/app/logs/seminar_platform.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=60

# Real-time optimization
MIN_SILENCE_MS=500
STATUS_INTERVAL_MS=1000
HYBRID_FAST_THRESHOLD_MS=300
HYBRID_QUALITY_DELAY_MS=2000

# Thai translation settings
THAI_POLITENESS_GENDER=male

# Enhanced noise filtering and quality control - ULTRA AGGRESSIVE  
MIN_TRANSLATION_WORDS=3
MIN_TRANSLATION_CHARS=10
ENABLE_NOISE_DETECTION=true

# WhisperGPT Provider specific settings
WHISPER_GPT_MODEL=whisper-1
WHISPER_GPT_TEMPERATURE=0.0