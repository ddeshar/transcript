# Core configuration - Choose your ASR provider:
# faster_whisper = Local, fastest, good quality (recommended)
# whisper_local = Local official Whisper, slower but excellent quality  
# whisper_gpt = Cloud API + GPT translation, slow but best Thai quality
# hybrid = Fast English + Delayed Thai (best of both worlds)
ASR_PROVIDER=faster_whisper
MT_PROVIDER=simple_thai
AUDIO_SAMPLE_RATE=16000
CORS_ORIGINS=http://localhost:8000

# Offline model locations (populated via scripts/download_models.py)
VOSK_MODEL_DIR=./models/vosk/vosk-model-small-en-us-0.15
WHISPER_CPP_MODEL_PATH=./models/whisper.cpp/ggml-small.en.bin
MARIAN_MODEL_DIR=./models/marian

# Faster-Whisper configuration (requires: pip install faster-whisper)
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_BEAM_SIZE=1
FASTER_WHISPER_CHUNK_DURATION=2.0

# CTranslate2 (optional offline MT)
CT2_MODEL_DIR=./models/ctranslate2/en-th
CT2_DEVICE=auto
CT2_COMPUTE_TYPE=int8_float16
CT2_BEAM_SIZE=1
CT2_MAX_LEN=256
CT2_SOURCE_PREFIX=

# Official OpenAI Whisper (local) - More accurate than faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_CHUNK_DURATION=2.0

# Cloud providers (optional - needed for whisper_gpt and hybrid quality)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_GPT_MODEL=gpt-3.5-turbo
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HUGGINGFACE_TOKEN=

# Logging
STATUS_INTERVAL_MS=1000
